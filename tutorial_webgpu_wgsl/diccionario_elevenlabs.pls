<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0"
    xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
        http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
    alphabet="ipa" xml:lang="es-ES">

  <!-- ========================================== -->
  <!-- 1. WGSL en español: "uve doble ge ese ele" -->
  <!-- ========================================== -->
  <lexeme>
    <grapheme>WGSL</grapheme>
    <alias>uve doble ge ese ele</alias>
  </lexeme>
  <lexeme>
    <grapheme>wgsl</grapheme>
    <alias>uve doble ge ese ele</alias>
  </lexeme>

  <!-- ========================================== -->
  <!-- 2. W3C en español: "uve doble tres ce"     -->
  <!-- ========================================== -->
  <lexeme>
    <grapheme>W3C</grapheme>
    <alias>uve doble tres ce</alias>
  </lexeme>
  <lexeme>
    <grapheme>w3c</grapheme>
    <alias>uve doble tres ce</alias>
  </lexeme>

  <!-- ========================================== -->
  <!-- 3. C++ leído en inglés: "C plus plus"     -->
  <!-- ========================================== -->
  <lexeme>
    <grapheme>C++</grapheme>
    <alias>C plus plus</alias>
  </lexeme>
  <lexeme>
    <grapheme>c++</grapheme>
    <alias>C plus plus</alias>
  </lexeme>

  <!-- ========================================== -->
  <!-- 4. GEMM leído como sigla/término: "YEM"    -->
  <!-- ========================================== -->
  <lexeme>
    <grapheme>GEMM</grapheme>
    <alias>YEM</alias>
  </lexeme>
  <lexeme>
    <grapheme>gemm</grapheme>
    <alias>YEM</alias>
  </lexeme>

  <!-- ======================================================= -->
  <!-- 5. Variable/eje matemático Y leído como "ye" (RAE)      -->
  <!--    (Se aplican lexemas compuestos para no colisionar   -->
  <!--     con la conjunción copulativa 'y')                  -->
  <!-- ======================================================= -->
  <lexeme>
    <grapheme>eje Y</grapheme>
    <alias>eje ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>eje y</grapheme>
    <alias>eje ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>coordenada Y</grapheme>
    <alias>coordenada ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>coordenada y</grapheme>
    <alias>coordenada ye</alias>
  </lexeme>

  <!-- ======================================================= -->
  <!-- 6. Conjunción copulativa ante 'ye' (Norma RAE):         -->
  <!--    Ante sonido consonántico /ye/ siempre se usa 'y'     -->
  <!--    (suena /i/) y NUNCA 'e'. Corregir cualquier 'e ye'   -->
  <!-- ======================================================= -->
  <lexeme>
    <grapheme>equis e ye</grapheme>
    <alias>equis y ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>equis e Ye</grapheme>
    <alias>equis y ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>e ye</grapheme>
    <alias>y ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>e Ye</grapheme>
    <alias>y ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>X e Y</grapheme>
    <alias>equis y ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>X e y</grapheme>
    <alias>equis y ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>x e y</grapheme>
    <alias>equis y ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>X y Y</grapheme>
    <alias>equis y ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>x y y</grapheme>
    <alias>equis y ye</alias>
  </lexeme>

  <!-- ======================================================= -->
  <!-- 7. Flotantes y números decimales en programación:        -->
  <!--    Pronunciación con "punto", NUNCA "coma" (0.5 -> cero  -->
  <!--    punto cinco) para reflejar literales de código         -->
  <!-- ======================================================= -->
  <lexeme>
    <grapheme>0.5</grapheme>
    <alias>cero punto cinco</alias>
  </lexeme>
  <lexeme>
    <grapheme>1.0</grapheme>
    <alias>uno punto cero</alias>
  </lexeme>
  <lexeme>
    <grapheme>0.0</grapheme>
    <alias>cero punto cero</alias>
  </lexeme>
  <lexeme>
    <grapheme>0.25</grapheme>
    <alias>cero punto veinticinco</alias>
  </lexeme>
  <lexeme>
    <grapheme>0.04</grapheme>
    <alias>cero punto cero cuatro</alias>
  </lexeme>
  <lexeme>
    <grapheme>0.03</grapheme>
    <alias>cero punto cero tres</alias>
  </lexeme>

  <!-- ======================================================= -->
  <!-- 8. Funciones de sombreado, derivadas e iluminación:      -->
  <!-- ======================================================= -->
  <lexeme>
    <grapheme>textureSample</grapheme>
    <alias>texture sample</alias>
  </lexeme>
  <lexeme>
    <grapheme>dpdx</grapheme>
    <alias>de pe de equis</alias>
  </lexeme>
  <lexeme>
    <grapheme>dpdy</grapheme>
    <alias>de pe de ye</alias>
  </lexeme>
  <lexeme>
    <grapheme>fwidth</grapheme>
    <alias>efe width</alias>
  </lexeme>
  <lexeme>
    <grapheme>Blinn-Phong</grapheme>
    <alias>Blinn Phong</alias>
  </lexeme>
  <lexeme>
    <grapheme>Cook-Torrance</grapheme>
    <alias>Cook Torrance</alias>
  </lexeme>

  <!-- ======================================================= -->
  <!-- 9. Pases de Render, Z-Buffer y Operaciones de Mezcla:    -->
  <!-- ======================================================= -->
  <lexeme>
    <grapheme>Z-Buffer</grapheme>
    <alias>Zeta Buffer</alias>
  </lexeme>
  <lexeme>
    <grapheme>Z-buffer</grapheme>
    <alias>Zeta Buffer</alias>
  </lexeme>
  <lexeme>
    <grapheme>Z-Fighting</grapheme>
    <alias>Zeta fighting</alias>
  </lexeme>
  <lexeme>
    <grapheme>Z-fighting</grapheme>
    <alias>Zeta fighting</alias>
  </lexeme>
  <lexeme>
    <grapheme>Early-Z</grapheme>
    <alias>Early Zeta</alias>
  </lexeme>
  <lexeme>
    <grapheme>Hi-Z</grapheme>
    <alias>Hi Zeta</alias>
  </lexeme>
  <lexeme>
    <grapheme>Reverse-Z</grapheme>
    <alias>Reverse Zeta</alias>
  </lexeme>
  <lexeme>
    <grapheme>loadOp</grapheme>
    <alias>load Op</alias>
  </lexeme>
  <lexeme>
    <grapheme>storeOp</grapheme>
    <alias>store Op</alias>
  </lexeme>
  <lexeme>
    <grapheme>depthWriteEnabled</grapheme>
    <alias>depth write enabled</alias>
  </lexeme>
  <lexeme>
    <grapheme>depthCompare</grapheme>
    <alias>depth compare</alias>
  </lexeme>

  <!-- ======================================================= -->
  <!-- 10. Compute-to-Render y Orquestación Host / Silicio:     -->
  <!-- ======================================================= -->
  <lexeme>
    <grapheme>Compute-to-Render</grapheme>
    <alias>Compute to Render</alias>
  </lexeme>
  <lexeme>
    <grapheme>compute-to-render</grapheme>
    <alias>Compute to Render</alias>
  </lexeme>
  <lexeme>
    <grapheme>PCI-Express</grapheme>
    <alias>P C I Express</alias>
  </lexeme>
  <lexeme>
    <grapheme>PCIe</grapheme>
    <alias>P C I e</alias>
  </lexeme>
  <lexeme>
    <grapheme>requestAnimationFrame</grapheme>
    <alias>request animation frame</alias>
  </lexeme>
  <lexeme>
    <grapheme>ResizeObserver</grapheme>
    <alias>Resize Observer</alias>
  </lexeme>
  <lexeme>
    <grapheme>OffscreenCanvas</grapheme>
    <alias>Offscreen Canvas</alias>
  </lexeme>
  <lexeme>
    <grapheme>devicePixelContentBoxSize</grapheme>
    <alias>device Pixel Content Box Size</alias>
  </lexeme>
  <lexeme>
    <grapheme>devicePixelRatio</grapheme>
    <alias>device Pixel Ratio</alias>
  </lexeme>
  <lexeme>
    <grapheme>getCurrentTexture</grapheme>
    <alias>get Current Texture</alias>
  </lexeme>
  <lexeme>
    <grapheme>commandEncoder</grapheme>
    <alias>command Encoder</alias>
  </lexeme>

  <!-- ======================================================= -->
  <!-- 11. Workshop 08 y Pipeline Gráfico Avanzado:              -->
  <!-- ======================================================= -->
  <lexeme>
    <grapheme>PBR</grapheme>
    <alias>pe be erre</alias>
  </lexeme>
  <lexeme>
    <grapheme>pbr</grapheme>
    <alias>pe be erre</alias>
  </lexeme>
  <lexeme>
    <grapheme>MVP</grapheme>
    <alias>eme uve pe</alias>
  </lexeme>
  <lexeme>
    <grapheme>writeBuffer</grapheme>
    <alias>write Buffer</alias>
  </lexeme>
  <lexeme>
    <grapheme>smoothstep</grapheme>
    <alias>smooth step</alias>
  </lexeme>
  <lexeme>
    <grapheme>Workshop 08</grapheme>
    <alias>workshop cero ocho</alias>
  </lexeme>
  <lexeme>
    <grapheme>workshop 08</grapheme>
    <alias>workshop cero ocho</alias>
  </lexeme>

</lexicon>

